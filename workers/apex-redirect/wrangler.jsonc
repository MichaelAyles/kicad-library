{
  // Redirects the bare domain to www. Deploy: npx wrangler deploy -c workers/apex-redirect/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "circuitsnips-apex-redirect",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "circuitsnips.com/*", "zone_name": "circuitsnips.com" }]
}
