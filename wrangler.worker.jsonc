{
  // CircuitSnips on Workers: the static export (out/) as assets, plus the
  // Hono API worker (worker/index.ts) for /api/* and asset misses.
  //
  //   Type-check:  npm run typecheck:worker
  //   Local dev:   npx wrangler dev -c wrangler.worker.jsonc  (secrets in .dev.vars)
  //   Secrets:     npx wrangler secret put <NAME> -c wrangler.worker.jsonc
  //                SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, ADMIN_API_KEY
  //                (optional: BOT_USER_ID, WORKOS_CLIENT_ID, WORKOS_ISSUER)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circuitsnips",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Assets are served first; the worker only runs for paths with no asset
  "assets": {
    "directory": "out",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    // Public circuit files: schematics/ and thumbnails/
    { "binding": "SCHEMATICS_BUCKET", "bucket_name": "circuitsnips" }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://pub-5cfb1ad5b22e451db2e5711b584b49c9.r2.dev",
    "SUPABASE_URL": "https://trjytrpqmfurirdaxlnr.supabase.co"
  },
  // The bare domain is redirected to www by workers/apex-redirect
  "workers_dev": false,
  "routes": [
    { "pattern": "www.circuitsnips.com/*", "zone_name": "circuitsnips.com" }
  ],
  "observability": { "enabled": true }
}
