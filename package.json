{
  "name": "circuitsnips",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "import": "tsx scripts/export-and-import.ts",
    "import:dry": "tsx scripts/export-and-import.ts --dry-run",
    "import:test": "tsx scripts/export-and-import.ts --limit 10 --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.75.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.107.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.13.18",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.17",
    "lucide-react": "^0.469.0",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8",
    "puppeteer": "^24.30.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "4.1.12",
    "wrangler": "^4.162.0"
  }
}
