# Supabase
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Sign-in provider, chosen at build time: "supabase" (default) or "workos"
# NEXT_PUBLIC_AUTH_PROVIDER="supabase"

# WorkOS AuthKit (only used when NEXT_PUBLIC_AUTH_PROVIDER="workos")
# Client ID from: https://dashboard.workos.com > API Keys (public, not a secret)
NEXT_PUBLIC_WORKOS_CLIENT_ID="client_..."
# Custom AuthKit domain in production (e.g. auth.circuitsnips.com); leave
# unset locally, where AuthKit runs in devMode against the WorkOS domain
# NEXT_PUBLIC_WORKOS_API_HOSTNAME="auth.circuitsnips.com"

# Supabase Service Role Key (for admin operations, keep secret!)
# Only needed for server-side admin operations
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: For local development with Supabase
# DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Cloudflare R2 Configuration (for thumbnail storage)
# Get these from: https://dash.cloudflare.com > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="circuitsnips"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"
